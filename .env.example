# Phase 0 environment template
DATABASE_URL=postgres://altax_app:changeme@localhost:5432/altax
# Optional: point local `npm run dev` / `npm test` at a SEPARATE database (e.g. a Neon
# branch) instead of DATABASE_URL above, so local work and tests never touch production
# data. Only read locally — production (Railway) always uses DATABASE_URL and never sees
# this var. Strongly recommended: Neon dashboard -> your project -> Branches -> "Create
# branch" from main -> copy that branch's connection string in here.
DATABASE_URL_DEV=
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h
PORT=4000

# Which portals must use two-factor authentication. Users on these portals cannot
# sign in until they have set up an authenticator app; users on any other portal
# may still turn 2FA on voluntarily.
#
# Leave the default unless there is a reason to change it. Narrow it to
# "admin,staff" if 2FA proves too much friction for clients and employees — those
# accounts only ever see their own data, while admin and staff can see every
# client's records, so the two are not equally risky.
#
# Setting this to an empty value makes 2FA optional on every portal: the
# emergency off switch, changeable without a code deploy. Accounts that already
# have 2FA enabled are still asked for a code either way — relaxing this setting
# never silently downgrades someone who is already protected.
REQUIRE_2FA_ROLES=admin,staff

# Portals that get a 6-digit code by EMAIL instead of an authenticator app.
# Weaker than an authenticator (whoever controls the mailbox can receive the
# code, and email is also the password-reset channel), but it needs nothing
# installed, and it still stops a leaked or reused password on its own — which
# is how these accounts actually get compromised.
#
# Applies only to accounts without an authenticator: a client who voluntarily
# turns on 2FA keeps using it, since it is the stronger factor. Set to an empty
# value to drop these portals back to password-only.
REQUIRE_EMAIL_OTP_ROLES=client,employee

# Base URL used to build portal invite links returned by POST /users (see
# src/modules/users/users.routes.ts and src/common/portalUserProvisioning.ts). Falls
# back to http://localhost:5173 if unset — set this to the real frontend origin once
# deployed so invite links/emails point somewhere the recipient can actually reach.
FRONTEND_BASE_URL=

# Master key for the Secure Vault and encrypted Payment Method fields
# (src/common/encryption.ts). Must be a base64-encoded 32-byte (256-bit) key.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key permanently and unrecoverably locks every encrypted value in the
# database — back it up somewhere durable outside this repo (a password manager,
# a secrets vault), never commit it, and never rotate it without a re-encryption plan.
VAULT_MASTER_KEY=

# Optional separate key for the weekly encrypted backup emails. When unset the
# backups are encrypted with VAULT_MASTER_KEY instead (deliberate: it is already
# the one secret the firm must keep a safe offline copy of). Restore decrypts
# server-side with the same variable — losing it makes every .enc backup
# unreadable.
BACKUP_PASSPHRASE=

# Stripe card payments on the public invoice link ("Pay by Card"). Get the
# secret key from dashboard.stripe.com -> Developers -> API keys (use the
# sk_live_... key; sk_test_... works for trying it out with test cards).
# Absent = the Pay button simply doesn't render; nothing else changes.
STRIPE_SECRET_KEY=

# Used only by the one-time/ incremental Sheets -> Postgres migration job
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/service-account.json
SOURCE_SPREADSHEET_ID=replace-with-the-existing-AL-TAX-spreadsheet-id

# Email sending (src/common/notifications.ts) — get an API key at https://resend.com.
# Sending is skipped with a clear "not configured" error until this is set; nothing
# breaks by leaving it blank.
RESEND_API_KEY=
RESEND_FROM_EMAIL=AL Tax Service <onboarding@resend.dev>

# Malware scanning for uploaded files (src/common/malwareScan.ts) — get a free-tier key
# at https://portal.cloudmersive.com/signup, then find it under API Keys. Left blank,
# uploads are still validated by MIME type and size but their contents are never
# scanned — the same state the app was already in.
CLOUDMERSIVE_API_KEY=

# SMS/WhatsApp sending (src/common/notifications.ts) — get these from a Twilio console
# (https://twilio.com). TWILIO_FROM_NUMBER is a Twilio phone number you've purchased.
# TWILIO_WHATSAPP_FROM additionally requires Twilio's WhatsApp Business API, which
# needs Meta business verification — a longer setup than SMS or email. Each channel
# is independently optional; missing ones just show "not configured" in the send UI.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
